# Release signing for Astral. Copy this file to base/keystore/keystore.properties
# and replace the CHANGE_ME values. storeFile is relative to base/keystore/.
# Never commit the real keystore.properties or the .jks key file (base/keystore/ is gitignored).
storeFile=astral-release.jks
storePassword=CHANGE_ME
keyAlias=astral
keyPassword=CHANGE_ME
